{
  "name": "@campuslive/contracts",
  "version": "1.0.0",
  "private": true,
  "description": "OpenAPI 3.1 contract for the CampusLive API + generated TypeScript types",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./openapi.yaml": "./openapi.yaml"
  },
  "files": [
    "openapi.yaml",
    "src"
  ],
  "scripts": {
    "generate": "openapi-typescript openapi.yaml -o src/types.gen.ts",
    "contracts:generate": "pnpm run generate",
    "lint": "redocly lint openapi.yaml",
    "typecheck": "tsc --noEmit",
    "test": "redocly lint openapi.yaml"
  },
  "devDependencies": {
    "@redocly/cli": "1.34.5",
    "openapi-typescript": "7.9.1",
    "typescript": "5.9.3"
  }
}
