{
  "name": "@campuslive/map-data",
  "version": "1.0.0",
  "private": true,
  "description": "Floor geometry pipeline: svg/floor-{1,2}.svg \u2192 building-a.json (MapSpec)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./building-a.json": "./building-a.json",
    "./schema.json": "./schema.json"
  },
  "files": [
    "README.md",
    "building-a.json",
    "schema.json",
    "src",
    "svg"
  ],
  "scripts": {
    "build": "tsx scripts/svg2map.ts",
    "svg:author": "python scripts/authoring/build_svg.py",
    "svg:check": "python scripts/authoring/check.py",
    "map:build": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "svgson": "5.3.1",
    "uuid": "11.1.0"
  },
  "devDependencies": {
    "@campuslive/contracts": "workspace:*",
    "@types/node": "22.15.3",
    "ajv": "8.17.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
