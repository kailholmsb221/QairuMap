{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campuslive.dev/schemas/map-spec.json",
  "title": "MapSpec",
  "description": "Geometry of one building, generated by `pnpm map:build` from packages/map-data/svg/floor-{1,2}.svg. The room programme it must satisfy is docs/BUILDING.md. Mirrors the MapSpec schema in packages/contracts/openapi.yaml — keep the two in step.",
  "type": "object",
  "additionalProperties": false,
  "required": ["building", "name", "timezone", "viewBox", "floors"],
  "properties": {
    "building": { "type": "string", "minLength": 1, "description": "Building code, e.g. \"A\"." },
    "name": { "type": "string", "minLength": 1 },
    "timezone": { "type": "string", "minLength": 1, "description": "IANA time zone." },
    "viewBox": {
      "type": "array",
      "description": "[minX, minY, width, height], shared by every floor.",
      "items": { "type": "number" },
      "minItems": 4,
      "maxItems": 4
    },
    "floors": {
      "type": "array",
      "description": "The building has exactly two floors.",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/MapFloor" }
    }
  },
  "$defs": {
    "PathData": {
      "type": "string",
      "description": "Absolute SVG path data, starting with M and closed with Z.",
      "pattern": "^M[\\s\\S]*Z$"
    },
    "BBox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "w": { "type": "number", "minimum": 0 },
        "h": { "type": "number", "minimum": 0 }
      }
    },
    "Point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
    },
    "MapZone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/PathData" }
      }
    },
    "MapRoom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "code", "name", "type", "wing", "schedulable", "path", "bbox", "label"],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "Deterministic UUID v5 of \"campuslive:room:{code}\".",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "code": {
          "type": "string",
          "description": "Upper-case alphanumeric with hyphens, e.g. \"100\", \"102A\", \"AI-LAB\", \"WC-N2\", \"CORE-S1\".",
          "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)*$"
        },
        "name": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["lecture", "seminar", "lab", "coworking", "admin", "service", "void"]
        },
        "wing": {
          "type": "string",
          "description": "Band of the shared plate the space sits in. Matches the `Wing` enum of packages/contracts/openapi.yaml and the `wing` type in the API's 0001_init.sql.",
          "enum": ["north", "south", "core"]
        },
        "capacity": { "type": "integer", "minimum": 1 },
        "schedulable": { "type": "boolean" },
        "path": { "$ref": "#/$defs/PathData" },
        "bbox": { "$ref": "#/$defs/BBox" },
        "label": { "$ref": "#/$defs/Point" }
      }
    },
    "MapCore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "code", "name", "path", "bbox", "label"],
      "properties": {
        "id": { "type": "string", "enum": ["core-n", "core-s"] },
        "code": { "type": "string", "pattern": "^CORE-[NS][0-9]+$" },
        "name": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/PathData" },
        "bbox": { "$ref": "#/$defs/BBox" },
        "label": { "$ref": "#/$defs/Point" }
      }
    },
    "MapLandmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "x", "y"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "MapEntrance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "x", "y", "main", "path"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "main": { "type": "boolean" },
        "path": { "$ref": "#/$defs/PathData" }
      }
    },
    "MapFloor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "planKey",
        "outline",
        "zones",
        "corridors",
        "rooms",
        "cores",
        "landmarks",
        "entrances"
      ],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "planKey": { "type": "string", "pattern": "^[a-z]-f[0-9]+$" },
        "outline": { "$ref": "#/$defs/PathData" },
        "zones": { "type": "array", "items": { "$ref": "#/$defs/MapZone" } },
        "corridors": { "type": "array", "items": { "$ref": "#/$defs/MapZone" } },
        "rooms": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/MapRoom" } },
        "cores": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/MapCore" }
        },
        "landmarks": { "type": "array", "items": { "$ref": "#/$defs/MapLandmark" } },
        "entrances": { "type": "array", "items": { "$ref": "#/$defs/MapEntrance" } },
        "atrium": {
          "$ref": "#/$defs/PathData",
          "description": "The atrium void. Present on floor 2 only, where it is also emitted as the room VOID-2."
        }
      }
    }
  }
}
