# CampusLive — environment template (ARCHITECTURE.md §8.5).
# Copy to infra/.env and fill in. Never commit real values.

# ---- API service ----
PORT=8080
DATABASE_URL=postgres://campuslive:@postgres:5432/campuslive?sslmode=disable
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# ---- Clock (deterministic demo / e2e) ----
# real   — time.Now()
# fixed  — always CLOCK_FIXED_AT
# offset — time.Now() + CLOCK_OFFSET
CLOCK_MODE=real
CLOCK_FIXED_AT=
CLOCK_OFFSET=

# ---- Engine thresholds ----
SOON_WINDOW=10m
ENDING_WINDOW=5m
NEXT_HORIZON=90m

# ---- Admin (demo panel / demo:script) ----
ADMIN_API_KEY=

# ---- Postgres container ----
POSTGRES_USER=campuslive
POSTGRES_PASSWORD=
POSTGRES_DB=campuslive

# ---- Web ----
NEXT_PUBLIC_API_URL=http://localhost:8080
API_URL=http://api:8080
